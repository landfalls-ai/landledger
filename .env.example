# Landledger, local development. Copy to .env (git-ignored) to change anything; every value here is the default.
# Development credentials only (local OrbStack). Never reuse them anywhere else.

# Postgres (deploy/compose.infra.yml, compose project landledger-infra). The owner runs migrations; the API connects as
# landledger_app, which inserts and reads the ledger but never changes it (migration 0008).
LANDLEDGER_PG_PASSWORD=landledger-dev
LANDLEDGER_OWNER_PG_URL=postgres://landledger:landledger-dev@127.0.0.1:25532/landledger
LANDLEDGER_APP_PG_PASSWORD=landledger-app-dev
LANDLEDGER_PG_URL=postgres://landledger_app:landledger-app-dev@127.0.0.1:25532/landledger

# The API and the console
LANDLEDGER_API_HOST=127.0.0.1
LANDLEDGER_API_PORT=4810
LANDLEDGER_CONSOLE_PORT=4811
LANDLEDGER_CONSOLE_URL=http://localhost:4811

# Sign-in through Landbright (OIDC, authorization code + PKCE, client_secret_post). The client secret is read from
# LANDLEDGER_OIDC_ENV_FILE (LANDBRIGHT_ISSUER, LANDBRIGHT_CLIENT_ID, LANDBRIGHT_CLIENT_SECRET), written by Landbright's
# session; it never goes in this repository.
LANDLEDGER_OIDC_ISSUER=http://localhost:4402/oidc
LANDLEDGER_OIDC_CLIENT_ID=landledger-local
LANDLEDGER_OIDC_REDIRECT_URI=http://localhost:4811/api/auth/oidc/callback
LANDLEDGER_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4811/
LANDLEDGER_OIDC_ENV_FILE=~/.config/land-family/landledger-local.env
LANDLEDGER_SESSION_HOURS=8

# Local only: with `on`, calls with neither a session nor an API key act as a local developer (controller). Off by
# default; the API refuses it on any host but loopback.
LANDLEDGER_DEV_AUTH=off

# First setup only: an admin key that mints keys until the first admin person (CFO or controller) signs in, never
# after (any string you choose; leave unset normally).
# LANDLEDGER_BOOTSTRAP_KEY=

# Seals session ID tokens, webhook secrets and relay channel signing secrets at rest (AES-256-GCM). Generate your own into apps/api/.env.local
# (git-ignored): openssl rand -base64 32. Unset: no ID token is kept and webhooks can't be created.
# LANDLEDGER_SECRET_KEY=

# How often the audit chain's head is anchored outside the database (Clickland log, webhook audit.anchor); 0 is off.
LANDLEDGER_AUDIT_ANCHOR_MINUTES=60

# Telemetry to Clickland's collector (OTLP over HTTP) as service landledger-api. LANDLEDGER_TELEMETRY=off turns it off.
LANDLEDGER_TELEMETRY=on
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:24318
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# The Kubernetes cluster whose node the Docker engine shares (OrbStack: one VM runs both). Docker's usage comes out of
# that node's idle so a day adds up to capacity × rate once; `none` for a Docker host of its own.
LANDLEDGER_DOCKER_SHARES_CLUSTER=orbstack

# Approval deadlines: business hours a step waits, the days that count (each whole in LANDLEDGER_TZ) and the holidays.
# This machine runs sun-thu in Asia/Jerusalem (.env.local), a default to confirm (docs/plan.md, Decisions).
LANDLEDGER_STEP_DEADLINE_HOURS=24
LANDLEDGER_BUSINESS_DAYS=mon-fri
LANDLEDGER_TZ=UTC
# LANDLEDGER_HOLIDAYS_FILE=deploy/holidays.txt

# Wave 3. Reconciliation's tolerance (percent) and its floor in USD; contracts' notice window; anomalies' smallest jump.
LANDLEDGER_RECONCILE_TOLERANCE_PCT=2
LANDLEDGER_RECONCILE_TOLERANCE_USD=0.50
LANDLEDGER_RENEWAL_WINDOW_DAYS=30
LANDLEDGER_ANOMALY_MIN_USD=1
# The dev-only anomaly spike (loopback API and database only; expires in two hours): off unless set to on.
# LANDLEDGER_DEV_ANOMALY=on
# Clickland keys (read; read and alerts:write) live in the untracked apps/api/.env.local, never here.
